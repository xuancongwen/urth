# Copy to deploy/deploy.env (gitignored) and fill in. deploy.sh sources it;
# variables already in the environment win.

# Hostname or IP of the LXC, reachable as root over ssh (a key or a
# password; the deploy asks for a password once per run if needed).
URTH_HOST=urth.lan
URTH_SSH_PORT=22
# Container CPU architecture: amd64 or arm64.
URTH_ARCH=amd64
# Install prefix, as set in setup.sh.
URTH_APP_DIR=/opt/urth
